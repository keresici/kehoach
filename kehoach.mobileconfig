	<key>PayloadDescription</key>
	<string>Cài app Kế Hoạch (kế hoạch, chi tiêu, thu nhập, nhật ký) lên Màn hình chính. Hồ sơ này CHỈ chứa biểu tượng và đường dẫn app, không cấp bất kỳ quyền nào trên máy. Có thể gỡ bất cứ lúc nào trong Cài đặt → Cài đặt chung → VPN &amp; Quản lý thiết bị.</string>
	<key>PayloadDisplayName</key>
	<string>Kế Hoạch</string>
